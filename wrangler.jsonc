{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aethercad",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
